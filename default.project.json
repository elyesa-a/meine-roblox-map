{
  "name": "meine-roblox-map",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Configs": {
        "$path": "src/shared/Configs"
      },
      "Modules": {
        "$path": "src/shared/Modules"
      },
      "Remotes": {
        "$path": "src/shared/Remotes"
      }
    },

    "ServerScriptService": {
      "Services": {
        "$path": "src/server/Services"
      },
      "Main": {
        "$path": "src/server/Main.server.luau"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [0.38823, 0.37254, 0.38823],
          "Locked": true,
          "Position": [0, -10, 0],
          "Size": [512, 20, 512]
        }
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0, 0, 0],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
