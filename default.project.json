{
  "name": "meine-roblox-map",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Configs": {
        "$path": "src/shared/Configs"
      },
      "Modules": {
        "$path": "src/shared/Modules"
      },
      "Remotes": {
        "$path": "src/shared/Remotes"
      }
    },

    "ServerScriptService": {
      "Services": {
        "$path": "src/server/Services"
      },
      "Main": {
        "$path": "src/server/Main.server.luau"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [0.38823, 0.37254, 0.38823],
          "Locked": true,
          "Position": [0, -12, 0],
          "Size": [1340, 20, 780]
        }
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.48, 0.46, 0.55],
        "OutdoorAmbient": [0.58, 0.55, 0.65],
        "Brightness": 3.5,
        "ColorShift_Top": [0.04, 0.02, 0.08],
        "ColorShift_Bottom": [0.02, 0.00, 0.04],
        "EnvironmentDiffuseScale": 0.55,
        "EnvironmentSpecularScale": 0.35,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
